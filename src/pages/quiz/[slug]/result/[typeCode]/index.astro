---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getQuizzes, getQuizBySlug } from '@/lib/payload'

export async function getStaticPaths() {
  const quizzes = await getQuizzes()
  const paths = []
  for (const quiz of quizzes) {
    for (const result of quiz.results || []) {
      paths.push({
        params: { slug: quiz.slug, typeCode: result.typeCode },
        props: { quiz, result },
      })
    }
  }
  return paths
}

const { quiz, result } = Astro.props

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Quiz',
    name: `${quiz.title} — ผลลัพธ์: ${result.title}`,
    description: result.shortDescription,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: 'https://quizdee.com/' },
      { '@type': 'ListItem', position: 2, name: 'แบบทดสอบ', item: 'https://quizdee.com/quiz/' },
      { '@type': 'ListItem', position: 3, name: quiz.title, item: `https://quizdee.com/quiz/${quiz.slug}/` },
      { '@type': 'ListItem', position: 4, name: result.title },
    ],
  },
]

const shareUrl = `https://quizdee.com/quiz/${quiz.slug}/result/${result.typeCode}/`
const shareText = encodeURIComponent(`ฉันคือ ${result.title} จาก ${quiz.title}`)
---

<BaseLayout
  title={`${result.title} — ผลลัพธ์ ${quiz.title}`}
  description={result.shortDescription}
  schemas={schemas}
>
  <article class="container-prose py-16">
    <p class="eyebrow mb-4">{quiz.title} · ผลลัพธ์ของคุณ</p>

    <!-- Big visual result card -->
    <div class="card text-center py-12 bg-coral-50/40">
      {result.emoji && <p class="text-display mb-4 leading-none">{result.emoji}</p>}
      <p class="font-mono text-h3 text-coral-600 mb-2">{result.typeCode}</p>
      <h1 class="text-h1 font-semibold mb-4">{result.title}</h1>
      <p class="text-body text-ink-700 max-w-xl mx-auto">{result.shortDescription}</p>
    </div>

    <!-- Share row -->
    <div class="flex flex-wrap items-center gap-3 my-8">
      <span class="eyebrow">SHARE</span>
      <a
        class="btn-ghost text-small"
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
      >Facebook</a>
      <a
        class="btn-ghost text-small"
        href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${shareText}`}
        target="_blank"
        rel="noopener noreferrer"
      >X / Twitter</a>
      <a
        class="btn-ghost text-small"
        href={`https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(shareUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
      >LINE</a>
      <button class="btn-ghost text-small" data-copy={shareUrl}>คัดลอกลิงก์</button>
    </div>

    <!-- Answer block (40-60 word for AI Overview) -->
    <p class="answer-block">{result.shortDescription}</p>

    <!-- BANNER SLOT 3: result-mid (highest CTR) -->
    <div class="ph-img my-8" style="height: 250px; max-width: 336px; margin: 2rem auto;">
      banner-result-mid · 300×250
    </div>

    {/* Strengths / Weaknesses */}
    {(result.strengths || result.weaknesses) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-12">
        {result.strengths && result.strengths.length > 0 && (
          <div class="card">
            <h3 class="text-h3 font-semibold mb-3">จุดแข็ง</h3>
            <ul class="space-y-2 text-small">
              {result.strengths.map((s) => <li>· {s.item}</li>)}
            </ul>
          </div>
        )}
        {result.weaknesses && result.weaknesses.length > 0 && (
          <div class="card">
            <h3 class="text-h3 font-semibold mb-3">จุดอ่อน</h3>
            <ul class="space-y-2 text-small">
              {result.weaknesses.map((w) => <li>· {w.item}</li>)}
            </ul>
          </div>
        )}
      </div>
    )}

    <!-- Return-visit loop -->
    <div class="card my-12">
      <p class="eyebrow mb-3">QUIZ ต่อไป</p>
      <h3 class="text-h3 font-semibold mb-4">ลองทำแบบทดสอบอื่นต่อ</h3>
      <div class="flex flex-wrap gap-3">
        <a href="/quiz/" class="btn-secondary">ดูแบบทดสอบทั้งหมด →</a>
        {result.category === 'mbti' && (
          <a href={`/mbti/${result.typeCode.toLowerCase()}/`} class="btn-secondary">
            อ่านเพิ่มเกี่ยวกับ {result.typeCode} →
          </a>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-copy') || ''
      try {
        await navigator.clipboard.writeText(url)
        const original = btn.textContent
        btn.textContent = 'คัดลอกแล้ว ✓'
        setTimeout(() => {
          btn.textContent = original
        }, 2000)
      } catch (err) {
        console.error('Copy failed:', err)
      }
    })
  })
</script>
