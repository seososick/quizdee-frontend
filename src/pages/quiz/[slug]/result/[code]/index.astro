---
/**
 * Universal Result Page — /quiz/[slug]/result/[code]/
 * Generated for every (quiz × archetype) at build time via import.meta.glob.
 */
import BaseLayout from '@/layouts/BaseLayout.astro'
import StickerDecor from '@/components/StickerDecor.astro'
import Mascot from '@/components/Mascot.astro'
import { CATALOG } from '@/lib/catalog'
import { loadMeta, loadArchetypes, archetypeName, archetypeUrlSlug, archetypeCode } from '@/lib/quiz-content'

export async function getStaticPaths() {
  const paths: Array<{ params: { slug: string; code: string }; props: any }> = []
  for (const entry of CATALOG) {
    const archetypes = loadArchetypes(entry.source_files.archetypes)
    for (const a of archetypes) {
      paths.push({
        params: { slug: entry.slug, code: archetypeUrlSlug(a) },
        props: { entry, archetype: a, allArchetypes: archetypes },
      })
    }
  }
  return paths
}

const { entry, archetype, allArchetypes } = Astro.props as any
const meta = loadMeta(entry.source_files.meta)

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://quizdee.com'
const code = archetypeCode(archetype)
const codeSlug = archetypeUrlSlug(archetype)
const pageUrl = `${siteUrl}/quiz/${entry.slug}/result/${codeSlug}/`

const archName = archetypeName(archetype)
const archEmoji = archetype.emoji || entry.emoji
const archTagline = archetype.tagline_th || ''
const archDesc = archetype.description_th || ''

// MBTI quizzes get the MBTI-specific cat; others get a celebrate cat
const MBTI_CODES = ['INTJ','INTP','ENTJ','ENTP','INFJ','INFP','ENFJ','ENFP','ISTJ','ISFJ','ESTJ','ESFJ','ISTP','ISFP','ESTP','ESFP']
const isMbtiArchetype = MBTI_CODES.includes(code)

// Compatible archetypes resolved with names + emojis
const compatList = (archetype.compatible_with || []).slice(0, 3).map((c: string) => {
  const found = allArchetypes.find((a: any) => archetypeCode(a) === c)
  return found ? {
    code: c,
    name: archetypeName(found),
    emoji: found.emoji || '✨',
    slug: archetypeUrlSlug(found),
  } : null
}).filter(Boolean)

const ogImage = `/og-default.svg?title=${encodeURIComponent(archEmoji + ' ' + archName)}&subtitle=${encodeURIComponent(entry.title_th)}&eyebrow=${encodeURIComponent('quizdee.com · ' + entry.category_label_th)}`

const schemas = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'แบบทดสอบ', item: siteUrl + '/quiz/' },
      { '@type': 'ListItem', position: 3, name: entry.title_th, item: `${siteUrl}/quiz/${entry.slug}/` },
      { '@type': 'ListItem', position: 4, name: archName, item: pageUrl },
    ],
  },
]

const shareText = `ฉันคือ ${archEmoji} ${archName}${archTagline ? ' — ' + archTagline : ''}`
const otherArchetypes = allArchetypes.filter((a: any) => archetypeCode(a) !== code).slice(0, 6)
---

<BaseLayout
  title={`${archName} | ${entry.title_th} — quizdee`}
  description={archDesc ? archDesc.slice(0, 155).replace(/\s+\S*$/, '…') : (archTagline ? `${archTagline} — ผลจากแบบทดสอบ ${entry.title_th} อ่านจุดแข็ง จุดอ่อน คู่ที่เข้ากัน และเทคนิคพัฒนาตัวเอง` : `ผลแบบทดสอบ ${entry.title_th} — ${archName} ${archTagline}`)}
  canonical={pageUrl}
  ogImage={ogImage}
  schemas={schemas}
  noindex={true}
>
  <section class="relative bg-butter-50 overflow-hidden">
    <StickerDecor />
    <div class="container-wide relative z-10 py-10 sm:py-14">
      <p class="font-mono text-caption uppercase tracking-widest text-coral-700 mb-2">
        <a href={`/quiz/${entry.slug}/`} class="hover:underline">{entry.title_th}</a> · ผลของคุณ
      </p>

      <!-- ─── Hero result card (1:1 screenshot-friendly) ─── -->
      <div id="result-card" class="max-w-md mx-auto bg-washi-50 border-2 border-sumi-900 rounded-3xl p-8 sm:p-10 text-center shadow-[8px_8px_0_0_rgba(31,26,20,0.95)] relative overflow-hidden">
        <div class="absolute top-3 right-3 text-caption font-mono text-sumi-400">quizdee.com</div>

        <!-- decorative dots -->
        <div class="absolute top-4 left-4 flex gap-1" aria-hidden="true">
          <div class="w-1.5 h-1.5 rounded-full bg-coral-500"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-butter-500"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-matcha-500"></div>
        </div>

        <div class="relative inline-block mb-4">
          {isMbtiArchetype ? (
            <Mascot mbti={code} size={200} alt={`${archName} cat`} loading="eager" class="mx-auto" />
          ) : (
            <Mascot pose="celebrate" size={200} alt={`${archName} celebration`} loading="eager" class="mx-auto" />
          )}
        </div>
        <p class="font-mono text-caption uppercase tracking-widest text-coral-700 mb-2">{code}</p>
        <h1 class="font-display text-h1 sm:text-display font-semibold text-sumi-900 mb-4 leading-tight text-balance">{archName}</h1>
        {archTagline && (
          <p class="text-body text-sumi-700 italic mb-4 text-pretty">"{archTagline}"</p>
        )}
        <p class="text-caption font-mono text-sumi-500">{entry.title_th}</p>
      </div>

      <!-- Share row -->
      <div class="max-w-md mx-auto mt-6 flex flex-wrap items-center justify-center gap-3">
        <button id="share-btn" class="inline-flex items-center gap-2 bg-sumi-900 text-butter-300 px-5 py-3 rounded-full font-semibold text-small border-2 border-sumi-900 hover:shadow-[4px_4px_0_0_rgb(255,138,107)] hover:-translate-y-0.5 hover:-translate-x-0.5 transition-all min-h-[44px]">
          📤 แชร์ให้เพื่อน
        </button>
        <a href={`/quiz/${entry.slug}/`} class="inline-flex items-center gap-2 bg-washi-50 text-sumi-900 px-5 py-3 rounded-full font-semibold text-small border-2 border-sumi-900 hover:bg-butter-100 transition-all min-h-[44px]">
          🔄 ทำใหม่
        </a>
        <a href="/quiz/" class="inline-flex items-center gap-2 bg-washi-50 text-sumi-900 px-5 py-3 rounded-full font-semibold text-small border-2 border-sumi-900 hover:bg-coral-50 transition-all min-h-[44px]">
          ✨ quiz อื่น
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Detail content ─── -->
  <section class="container-wide py-10 sm:py-16">
    <div class="max-w-2xl mx-auto space-y-8">
      {archDesc && (
        <div>
          <h2 class="font-display text-h2 font-semibold text-sumi-900 mb-3">เกี่ยวกับคุณ</h2>
          <p class="text-body text-sumi-700 leading-relaxed text-pretty whitespace-pre-line">{archDesc}</p>
        </div>
      )}

      {(archetype.strengths_th || archetype.green_flags_th) && (
        <div class="bg-matcha-50 border-2 border-sumi-900 rounded-2xl p-6 shadow-[4px_4px_0_0_rgba(31,26,20,0.95)]">
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-3">✅ จุดแข็ง / สิ่งดี</h3>
          <ul class="space-y-2 text-body text-sumi-800">
            {(archetype.strengths_th || archetype.green_flags_th || []).map((s: string) => (
              <li class="flex gap-2"><span class="text-coral-500 flex-shrink-0">▸</span><span>{s}</span></li>
            ))}
          </ul>
        </div>
      )}

      {(archetype.needs_th || archetype.watchouts_th || archetype.red_flags_th || archetype.watchout_th) && (
        <div class="bg-coral-50 border-2 border-sumi-900 rounded-2xl p-6 shadow-[4px_4px_0_0_rgba(31,26,20,0.95)]">
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-3">⚠️ สิ่งที่ควรรู้</h3>
          <ul class="space-y-2 text-body text-sumi-800">
            {(() => {
              const items: string[] = []
              if (Array.isArray(archetype.needs_th)) items.push(...archetype.needs_th)
              if (Array.isArray(archetype.watchouts_th)) items.push(...archetype.watchouts_th)
              if (Array.isArray(archetype.red_flags_th)) items.push(...archetype.red_flags_th)
              if (typeof archetype.watchout_th === 'string') items.push(archetype.watchout_th)
              return items
            })().map((s: string) => (
              <li class="flex gap-2"><span class="text-coral-500 flex-shrink-0">▸</span><span>{s}</span></li>
            ))}
          </ul>
        </div>
      )}

      {archetype.shareable_quote_th && (
        <div class="bg-coral-100 border-2 border-sumi-900 rounded-2xl p-6 shadow-[4px_4px_0_0_rgba(31,26,20,0.95)]">
          <p class="text-caption font-mono uppercase tracking-widest text-coral-700 mb-2">💬 quote ของคุณ</p>
          <blockquote class="font-display text-h3 text-sumi-900 leading-snug text-balance italic">"{archetype.shareable_quote_th}"</blockquote>
        </div>
      )}

      {Array.isArray(archetype.weaknesses_th) && archetype.weaknesses_th.length > 0 && (
        <div class="bg-ume-50 border-2 border-sumi-900 rounded-2xl p-6 shadow-[4px_4px_0_0_rgba(31,26,20,0.95)]">
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-3">🪞 จุดที่ควรระวัง</h3>
          <ul class="space-y-2 text-body text-sumi-800">
            {archetype.weaknesses_th.map((s: string) => (
              <li class="flex gap-2"><span class="text-coral-500 flex-shrink-0">▸</span><span>{s}</span></li>
            ))}
          </ul>
        </div>
      )}

      {Array.isArray(archetype.growth_tips_th) && archetype.growth_tips_th.length > 0 && (
        <div class="bg-matcha-100 border-2 border-sumi-900 rounded-2xl p-6 shadow-[4px_4px_0_0_rgba(31,26,20,0.95)]">
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-3">🌱 พัฒนาตัวเองยังไงต่อ</h3>
          <ul class="space-y-2 text-body text-sumi-800">
            {archetype.growth_tips_th.map((s: string) => (
              <li class="flex gap-2"><span class="text-matcha-700 flex-shrink-0">✦</span><span>{s}</span></li>
            ))}
          </ul>
        </div>
      )}

      {Array.isArray(archetype.famous_examples_th) && archetype.famous_examples_th.length > 0 && (
        <div>
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-3">⭐ คนดังคล้ายคุณ</h3>
          <div class="flex flex-wrap gap-2">
            {archetype.famous_examples_th.map((s: string) => (
              <span class="bg-washi-50 border border-sumi-300 rounded-full px-3 py-1.5 text-small text-sumi-800">{s}</span>
            ))}
          </div>
        </div>
      )}

      {compatList.length > 0 && (
        <div class="bg-infj-50 border-2 border-sumi-900 rounded-2xl p-6 shadow-[4px_4px_0_0_rgba(31,26,20,0.95)]">
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-3">💞 เข้ากับใคร</h3>
          <div class="flex flex-wrap gap-3">
            {compatList.map((c: any) => (
              <a href={`/quiz/${entry.slug}/result/${c.slug}/`} class="bg-washi-50 border-2 border-sumi-300 hover:border-sumi-900 rounded-xl px-4 py-2 inline-flex items-center gap-2 transition-colors">
                <span class="text-2xl">{c.emoji}</span>
                <span class="font-semibold text-sumi-900">{c.name}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      {archetype.career_match_th && (
        <div>
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-2">💼 อาชีพที่เหมาะ</h3>
          <p class="text-body text-sumi-700">{Array.isArray(archetype.career_match_th) ? archetype.career_match_th.join(' · ') : archetype.career_match_th}</p>
        </div>
      )}

      {archetype.action_advice_th && (
        <div class="bg-butter-100 border-2 border-sumi-900 rounded-2xl p-6 shadow-[4px_4px_0_0_rgba(31,26,20,0.95)]">
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-3">📝 คำแนะนำ</h3>
          <ul class="space-y-2 text-body text-sumi-800">
            {(archetype.action_advice_th || []).map((s: string) => (
              <li class="flex gap-2"><span class="text-coral-500 flex-shrink-0">▸</span><span>{s}</span></li>
            ))}
          </ul>
          {archetype.disclaimer_th && (
            <p class="mt-4 pt-4 border-t border-sumi-300 text-caption text-sumi-500 italic">{archetype.disclaimer_th}</p>
          )}
        </div>
      )}

      {otherArchetypes.length > 0 && (
        <div>
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-3">🔁 ผลอื่นในแบบทดสอบนี้</h3>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            {otherArchetypes.map((a: any) => (
              <a href={`/quiz/${entry.slug}/result/${archetypeUrlSlug(a)}/`} class="bg-washi-50 border border-sumi-300 hover:border-sumi-900 rounded-xl p-2 inline-flex items-center gap-2 text-small transition-colors">
                <span class="text-xl">{a.emoji || '✨'}</span>
                <span class="text-sumi-700 truncate">{archetypeName(a).split(' ')[0].split('—')[0].trim()}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- More quizzes -->
  <section class="bg-washi-100 py-10">
    <div class="container-wide">
      <h2 class="font-display text-h2 font-semibold text-sumi-900 text-center mb-6">ลอง quiz อื่นต่อ?</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 max-w-5xl mx-auto">
        {CATALOG.filter(q => q.slug !== entry.slug).slice(0, 5).map((q) => (
          <a href={`/quiz/${q.slug}/`} class={`${q.bg} group block rounded-xl border-2 border-sumi-900 p-3 shadow-[3px_3px_0_0_rgba(31,26,20,0.95)] hover:-translate-y-0.5 hover:-translate-x-0.5 hover:shadow-[5px_5px_0_0_rgba(31,26,20,0.95)] transition-all`}>
            <div class="text-2xl mb-1">{q.emoji}</div>
            <p class="font-display text-small font-semibold text-sumi-900 leading-tight line-clamp-2">{q.title_th}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ shareText, pageUrl, archName, slug: entry.slug, code }}>
  // ─── A.5 Badge unlock: persist {slug: code} to localStorage so homepage badge collection updates
  try {
    const STORAGE = 'quizdee:badges'
    const raw = localStorage.getItem(STORAGE)
    const badges = raw ? JSON.parse(raw) : {}
    badges[slug] = code
    localStorage.setItem(STORAGE, JSON.stringify(badges))
  } catch {}

  const btn = document.getElementById('share-btn')
  if (btn) {
    btn.addEventListener('click', async () => {
      const text = `${shareText}\n\nลองทำดูที่ ${pageUrl}`
      if (navigator.share) {
        try { await navigator.share({ title: archName, text, url: pageUrl }) } catch {}
      } else {
        try {
          await navigator.clipboard.writeText(text)
          btn.textContent = '✅ คัดลอกแล้ว!'
          setTimeout(() => { btn.innerHTML = '📤 แชร์ให้เพื่อน' }, 2000)
        } catch { window.prompt('คัดลอกลิงก์:', pageUrl) }
      }
    })
  }
</script>
