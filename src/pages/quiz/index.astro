---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getQuizzes } from '../../lib/payload'

const quizzes = await getQuizzes()
---

<BaseLayout
  title="แบบทดสอบทั้งหมด — quizdee"
  description="แบบทดสอบบุคลิกภาพ MBTI, Love Language, อาชีพ และอื่นๆ ฟรีไม่ต้องสมัคร"
>
  <section class="container-wide py-16">
    <p class="eyebrow mb-4">QUIZ INDEX</p>
    <h1 class="text-h1 font-semibold mb-12">แบบทดสอบทั้งหมด</h1>

    {quizzes.length === 0 ? (
      <div class="card text-center py-16">
        <p class="eyebrow mb-3">EMPTY</p>
        <h2 class="text-h2 font-semibold mb-3">ยังไม่มีแบบทดสอบ</h2>
        <p class="text-ink-700">เรากำลังเตรียมเนื้อหา ติดตามได้เร็วๆ นี้</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {quizzes.map((quiz) => (
          <a href={`/quiz/${quiz.slug}/`} class="card hover:shadow-md transition-shadow">
            <p class="eyebrow mb-2">{quiz.category}</p>
            <h3 class="font-display text-h3 font-semibold mb-2">{quiz.title}</h3>
            <p class="text-small text-ink-700 mb-4 line-clamp-3">{quiz.description}</p>
            <p class="text-caption text-ink-500">
              {quiz.estimatedMinutes} นาที · {quiz.questions?.length || 0} คำถาม
            </p>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
