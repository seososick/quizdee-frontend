---
import BaseLayout from '@/layouts/BaseLayout.astro'
import blogData from '@/data/blog-posts.json'

export async function getStaticPaths() {
  const posts = (blogData as any).posts || []
  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://quizdee.com'
const pageUrl = `${siteUrl}/blog/${post.slug}/`
const categoryLabels: Record<string, string> = {
  PERSONALITY: 'บุคลิกภาพ', PSYCHOLOGY: 'จิตวิทยา', LOVE: 'ความรัก',
  WORK: 'อาชีพ', WELLBEING: 'สุขภาพใจ', POP_CULTURE: 'ป๊อปคัลเจอร์',
}

const schemas: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.metaDescription,
    datePublished: post.publishedAt,
    dateModified: post.publishedAt,
    inLanguage: 'th',
    mainEntityOfPage: pageUrl,
    author: post.author?.name
      ? { '@type': 'Person', name: post.author.name }
      : { '@type': 'Organization', name: 'Quizdee' },
    publisher: {
      '@type': 'Organization',
      name: 'Quizdee',
      url: siteUrl + '/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: siteUrl + '/' },
      { '@type': 'ListItem', position: 2, name: 'บทความ', item: siteUrl + '/blog/' },
      { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
    ],
  },
  ...(post.faq && post.faq.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.faq.map((q: any) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: { '@type': 'Answer', text: q.answer },
        })),
      }]
    : []),
]
---

<BaseLayout
  title={`${post.title} — quizdee`}
  description={post.metaDescription}
  canonical={pageUrl}
  ogType="article"
  schemas={schemas}
>
  <article class="container-prose py-16">
    <p class="eyebrow mb-4">{categoryLabels[post.category] || post.category}{post.publishedAt && ` · ${new Date(post.publishedAt).toLocaleDateString('th-TH')}`}</p>
    <h1 class="text-h1 font-semibold mb-6 leading-tight">{post.title}</h1>

    {post.answerBlock && <p class="answer-block">{post.answerBlock}</p>}

    {post.content_html && (
      <div class="prose-content my-8 text-body" set:html={post.content_html} />
    )}

    {post.faq && post.faq.length > 0 && (
      <section class="my-12">
        <h2 class="text-h2 font-semibold mb-6">คำถามที่พบบ่อย</h2>
        <div class="space-y-3">
          {post.faq.map((q: any) => (
            <details class="card cursor-pointer group">
              <summary class="font-display font-semibold text-h3 list-none flex justify-between items-start gap-4">
                <span>{q.question}</span>
                <span class="text-coral-400 group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="mt-4 text-sumi-700">{q.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {(post.relatedQuiz?.length || post.relatedResults?.length) && (
      <section class="card my-12">
        <p class="eyebrow mb-3">อ่านต่อ / ทำแบบทดสอบ</p>
        <div class="flex flex-wrap gap-3">
          {post.relatedQuiz?.map((q: any) => (
            <a href={`/quiz/${q.slug}/`} class="btn-secondary text-small">→ ทำ {q.title}</a>
          ))}
          {post.relatedResults?.map((r: any) => (
            <a href={`/mbti/${r.typeCode.toLowerCase()}/`} class="btn-secondary text-small">→ {r.title}</a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
