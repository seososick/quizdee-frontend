---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PlayCard from '@/components/PlayCard.astro'
import StickerDecor from '@/components/StickerDecor.astro'
import Mascot from '@/components/Mascot.astro'
import { CATALOG, CATEGORIES } from '@/lib/catalog'
import { getBlogPosts } from '@/lib/payload'

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://quizdee.com'
const featured = CATALOG.filter((q) => q.featured).slice(0, 3)
const allCount = CATALOG.length

let recentBlog: any[] = []
try { recentBlog = (await getBlogPosts()).slice(0, 3) } catch { recentBlog = [] }

const featuredQuiz = CATALOG[0]

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Quizdee',
    alternateName: ['ควิซดี', 'quizdee.com'],
    url: siteUrl + '/',
    inLanguage: 'th',
    description: 'แบบทดสอบบุคลิกภาพ MBTI / จิตวิทยา / Love Language / Trend ฉบับเข้าใจคนไทยวัยทำงาน',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Quizdee',
    url: siteUrl + '/',
    logo: `${siteUrl}/logo.svg`,
    foundingDate: '2026',
    description: 'แบบทดสอบบุคลิกภาพภาษาไทย เนื้อหาสำหรับคนวัยทำงาน',
    knowsLanguage: ['th', 'en'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'แบบทดสอบยอดนิยม',
    itemListElement: featured.map((q, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: q.title_th,
      url: `${siteUrl}/quiz/${q.slug}/`,
    })),
  },
]
---

<BaseLayout
  title="quizdee — แบบทดสอบบุคลิกภาพ ภาษาไทย ฉบับสนุก แชร์เพื่อน"
  description={`${allCount} แบบทดสอบ ภาษาไทย — MBTI, Big Five, Enneagram, Attachment Style, K-drama, Cat MBTI, AI Friend และอีกมาก ฟรี ไม่ต้องสมัคร รู้ผลใน 3-4 นาที`}
  schemas={schemas}
  keywords={['quizdee', 'แบบทดสอบ', 'MBTI', 'แบบทดสอบบุคลิกภาพ', 'แบบทดสอบความรัก', 'จิตวิทยา', 'Big Five', 'Enneagram', 'Love Language', 'แบบทดสอบไทย']}
>
  <!-- ═══ HERO ═════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-butter-50">
    <StickerDecor />
    <div class="container-wide relative z-10 pt-12 pb-14 sm:pt-16 sm:pb-20 md:pt-20 md:pb-28">
      <div class="grid md:grid-cols-[1fr_auto] gap-8 items-end">
        <div class="max-w-3xl">
        <p class="inline-flex items-center gap-2 rounded-full bg-sumi-900 text-butter-300 px-3 py-1 font-mono text-caption uppercase tracking-widest mb-6">
          <span class="inline-block w-2 h-2 rounded-full bg-coral-500 animate-pulse"></span>
          EST. 2026 · BANGKOK · {allCount} QUIZZES
        </p>

        <h1 class="font-display font-medium leading-[1.05] tracking-tight text-balance text-sumi-900" style="font-size: clamp(2.25rem, 7vw, 4.5rem);">
          เล่น quiz ที่
          <span class="relative inline-block">
            <span class="relative z-10">รู้จักคุณ</span>
            <svg class="absolute -bottom-1 left-0 w-full h-3 text-coral-500" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true">
              <path d="M2 8 Q50 2, 100 6 T198 6" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            </svg>
          </span>
          <br />
          มากกว่า MBTI ทั่วไป <em class="italic font-light text-coral-700">ฉบับคนไทย</em>
        </h1>

        <p class="mt-6 max-w-xl text-body text-sumi-700 text-pretty">
          {allCount} แบบทดสอบสั้นๆ ใช้เวลา 3-4 นาที — Big Five, Enneagram, Cat MBTI, K-drama, AI Friend และอีกมาก <strong class="font-semibold text-sumi-900">แชร์ให้เพื่อนทำแล้วเทียบกัน</strong>
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={`/quiz/${featuredQuiz.slug}/`} class="inline-flex items-center gap-2 bg-sumi-900 text-butter-300 px-6 py-3.5 rounded-full font-semibold text-body border-2 border-sumi-900 shadow-[4px_4px_0_0_rgb(255,138,107)] hover:shadow-[6px_6px_0_0_rgb(255,138,107)] hover:-translate-y-0.5 hover:-translate-x-0.5 transition-all min-h-[48px]">
            <span>เริ่มเล่น MBTI</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/quiz/" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full font-semibold text-body border-2 border-sumi-900 bg-washi-50 hover:bg-butter-100 transition-all min-h-[48px]">
            ดู quiz ทั้งหมด ({allCount})
          </a>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4 text-small text-sumi-700">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 rounded-full bg-coral-300 border-2 border-butter-50"></div>
            <div class="w-8 h-8 rounded-full bg-matcha-300 border-2 border-butter-50"></div>
            <div class="w-8 h-8 rounded-full bg-asagi-300 border-2 border-butter-50"></div>
            <div class="w-8 h-8 rounded-full bg-ume-300 border-2 border-butter-50"></div>
          </div>
          <span class="text-sumi-700">
            <strong class="font-semibold text-sumi-900">{allCount} quizzes พร้อมเล่น</strong> · ทำแล้วได้การ์ดสวยส่ง Story
          </span>
        </div>
        </div>

        <!-- Mascot (right column on md+) -->
        <div class="hidden md:flex items-end justify-end">
          <Mascot pose="wave" size={280} alt="แมว Quizdee กำลังทักทาย" loading="eager" class="drop-shadow-[4px_4px_0_rgba(31,26,20,0.15)]" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED 3 ═══ -->
  <section class="container-wide py-12 sm:py-16">
    <p class="font-mono text-caption uppercase tracking-widest text-sumi-500 mb-2">⭐ FEATURED</p>
    <h2 class="font-display text-h1 font-semibold text-sumi-900 mb-8">เริ่มจาก quiz ฮิตสุด</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {featured.map((q) => (
        <PlayCard
          href={`/quiz/${q.slug}/`}
          title={q.title_th}
          subtitle={q.subtitle_th}
          emoji={q.emoji}
          category={q.category_label_th}
          bg={q.bg}
          duration={`${q.duration_min} นาที`}
          questions={q.question_count}
          badge={q.badge}
          rotate={q.rotate ?? 0}
        />
      ))}
    </div>
  </section>

  <!-- ═══ "ในฉบับนี้" Editorial Sidebar (A.5 — borrowed from B) ═══ -->
  <section class="bg-washi-50 border-y-4 border-sumi-900 py-12 sm:py-16">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Lede col -->
        <div class="lg:col-span-2 lg:pr-8 lg:border-r-2 lg:border-sumi-900">
          <p class="font-mono text-caption uppercase tracking-[0.25em] text-coral-700 mb-3">— ทำไมถึงทำเว็บนี้ —</p>
          <h2 class="font-display font-medium leading-[1.1] tracking-tight text-balance text-sumi-900 mb-5" style="font-size: clamp(1.875rem, 4.5vw, 3rem);">
            เลิกถามว่า <em class="italic font-light text-coral-700">"คุณเป็น MBTI อะไร"</em><br>
            แล้วลองรู้จักตัวเองให้ลึกกว่านั้น
          </h2>
          <div class="prose-content drop-cap max-w-2xl">
            <p>เราไม่ได้ทำเว็บแบบทดสอบเพราะอยากให้คุณรู้ว่าเป็น INFJ. เราทำเพราะเชื่อว่าคนเรามีหลายมิติ — ที่บ้าน, ที่ทำงาน, ตอนเครียด, ตอนรัก — มันต่างกันคนละเรื่องเลย.</p>
            <p class="mt-4">17 แบบทดสอบของเราอ้างอิงจิตวิทยาจริง (Big Five OCEAN, Enneagram, Attachment Style) ผสมเทรนด์ปัจจุบัน (Doom Scroll, AI Friend, K-pop bias) — สั้น 3-4 นาที, ฟรี, ไม่ต้องล็อกอิน, แชร์แล้วทำกับเพื่อนได้.</p>
          </div>
        </div>

        <!-- TOC sidebar -->
        <aside>
          <p class="font-mono text-caption uppercase tracking-[0.2em] text-coral-700 mb-3 pb-2 border-b-4 border-sumi-900">— ในฉบับนี้ · IN THIS ISSUE —</p>
          <ol class="space-y-0">
            {CATALOG.slice(0, 8).map((q, i) => (
              <li class="editorial-toc-item">
                <a href={`/quiz/${q.slug}/`} class="flex-1 group">
                  <span class="editorial-toc-num">{String(i + 1).padStart(2, '0')}.</span>
                  <span class="font-display text-body font-medium text-sumi-900 group-hover:text-coral-700 transition-colors">{q.title_th}</span>
                </a>
                <span class="font-mono text-caption text-sumi-500 whitespace-nowrap">{q.duration_min} นาที</span>
              </li>
            ))}
            <li class="pt-2">
              <a href="/quiz/" class="font-mono text-caption uppercase tracking-wider text-coral-700 hover:underline">+ อีก {allCount - 8} ฉบับ →</a>
            </li>
          </ol>

          <!-- Badge collection (A.5 — borrowed from C) -->
          <div class="mt-8 pt-6 border-t-2 border-sumi-300">
            <p class="font-mono text-caption uppercase tracking-[0.2em] text-coral-700 mb-3">— เหรียญสะสม · YOUR BADGES —</p>
            <div id="badge-collection" class="flex flex-wrap gap-1.5">
              <p data-empty class="text-small text-sumi-500 italic">ยังไม่มี ลองทำ quiz ก่อน 🌱</p>
            </div>
            <p class="mt-3 text-caption font-mono text-sumi-500"><span data-badge-count>0</span>/{allCount} เหรียญ</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section class="container-wide py-12 sm:py-16">
    <h2 class="font-display text-h1 font-semibold text-sumi-900 text-center mb-10">เล่นง่ายๆ ใน 3 ขั้น</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
      {[
        { num: '01', emoji: '🎯', title: 'เลือก quiz', desc: `จาก ${allCount} ชุด — MBTI, จิตวิทยา, เทรนด์ 2025` },
        { num: '02', emoji: '✨', title: 'ตอบ 12-16 ข้อ', desc: 'a-e ตัวเลือก สั้นๆ สนุกๆ ใช้เวลา 3-4 นาที' },
        { num: '03', emoji: '📤', title: 'ได้การ์ดสวย', desc: 'แชร์ Story / ส่งเพื่อนทำแล้วเทียบกัน' },
      ].map((step) => (
        <div class="bg-washi-50 border-2 border-sumi-900 rounded-2xl p-6 shadow-[4px_4px_0_0_rgba(31,26,20,0.95)]">
          <p class="font-mono text-caption text-sumi-500 mb-3">{step.num}</p>
          <div class="text-4xl mb-3">{step.emoji}</div>
          <h3 class="font-display text-h3 font-semibold text-sumi-900 mb-2">{step.title}</h3>
          <p class="text-small text-sumi-700">{step.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ BLOG ═══ -->
  {recentBlog.length > 0 && (
    <section class="container-wide py-12 sm:py-16 border-t border-washi-300">
      <div class="mb-8 flex items-end justify-between gap-4">
        <h2 class="font-display text-h1 font-semibold text-sumi-900">อ่านเพิ่มเติม</h2>
        <a href="/blog/" class="font-mono text-small font-bold text-coral-700 hover:text-coral-500 underline underline-offset-4 decoration-2 whitespace-nowrap">ทั้งหมด →</a>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {recentBlog.map((post) => (
          <a href={`/blog/${post.slug}/`} class="group block">
            <p class="font-mono text-caption uppercase tracking-widest text-sumi-500 mb-2">{post.category}</p>
            <h3 class="font-display text-h3 font-semibold mb-2 text-balance group-hover:text-coral-700 transition-colors">{post.title}</h3>
            <p class="text-small text-sumi-700 text-pretty line-clamp-3">{post.metaDescription}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // ─── Badge collection: render unlocked badges from localStorage
  // Format: localStorage 'quizdee:badges' = '{"big-five":"creative-sage","mbti":"intj",...}'
  const STORAGE = 'quizdee:badges'
  const slugMap: Record<string, { emoji: string; title: string }> = {
    'mbti': { emoji: '🌙', title: 'MBTI 16' },
    'big-five': { emoji: '🧠', title: 'Big Five' },
    'enneagram': { emoji: '🔮', title: 'Enneagram' },
    'cat-mbti': { emoji: '🐈‍⬛', title: 'Cat MBTI' },
    'love-language': { emoji: '💌', title: 'Love Lang' },
    'attachment-style': { emoji: '💙', title: 'Attachment' },
    'office-mbti': { emoji: '💼', title: 'Office' },
    'burnout-risk': { emoji: '🔥', title: 'Burnout' },
    'career-identity': { emoji: '🚀', title: 'Career' },
    'coping-style': { emoji: '🌧️', title: 'Coping' },
    'kdrama-mbti': { emoji: '🎬', title: 'K-drama' },
    'kpop-bias-role': { emoji: '🎤', title: 'K-pop' },
    'ai-friend': { emoji: '🤖', title: 'AI Friend' },
    'doomscroll-persona': { emoji: '📱', title: 'Doom Scroll' },
    'spending-style': { emoji: '💸', title: 'Spending' },
    'aesthetic-style': { emoji: '🌸', title: 'Aesthetic' },
    'mootelu-style': { emoji: '✨', title: 'Mootelu' },
  }

  try {
    const raw = localStorage.getItem(STORAGE)
    const badges: Record<string, string> = raw ? JSON.parse(raw) : {}
    const keys = Object.keys(badges)
    const container = document.getElementById('badge-collection')
    const countEl = document.querySelector('[data-badge-count]')
    if (countEl) countEl.textContent = String(keys.length)
    if (container && keys.length > 0) {
      container.innerHTML = ''
      keys.forEach((slug) => {
        const meta = slugMap[slug] || { emoji: '✨', title: slug }
        const badge = badges[slug]
        const a = document.createElement('a')
        a.href = `/quiz/${slug}/result/${badge.toLowerCase().replace(/_/g, '-')}/`
        a.className = 'inline-flex items-center gap-1 bg-butter-100 border-2 border-sumi-900 rounded-full px-2.5 py-1 text-small font-semibold text-sumi-900 hover:bg-butter-300 transition-all'
        a.title = `${meta.title}: ${badge}`
        a.innerHTML = `<span>${meta.emoji}</span><span class="font-mono text-caption">${badge}</span>`
        container.appendChild(a)
      })
    }
  } catch {}
</script>
