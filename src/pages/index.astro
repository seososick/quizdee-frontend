---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getQuizzes, getMbtiTypes, getBlogPosts } from '@/lib/payload'

const quizzes = await getQuizzes()
const mbtiTypes = await getMbtiTypes()
const recentBlog = (await getBlogPosts()).slice(0, 4)
const featuredQuiz = quizzes[0]

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Quizdee',
    url: 'https://quizdee.com/',
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://quizdee.com/?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Quizdee',
    url: 'https://quizdee.com/',
    description: 'แบบทดสอบบุคลิกภาพ MBTI / Love Language / Fun Quiz ภาษาไทย',
  },
]
---

<BaseLayout
  title="quizdee — แบบทดสอบบุคลิกภาพ ฉบับเข้าใจคนไทยวัยทำงาน"
  description="ทำแบบทดสอบ MBTI / Love Language / Personality Quiz ภาษาไทย เนื้อหาสำหรับคนวัยทำงานจริงๆ ฟรี ไม่ต้องสมัคร"
  schemas={schemas}
>
  <!-- HERO -->
  <section class="container-wide py-16 md:py-24">
    <p class="eyebrow mb-4">EST. 2026 · BANGKOK</p>
    <h1 class="text-display font-semibold leading-[1.05] tracking-tight max-w-4xl">
      เข้าใจตัวเอง<br />
      ผ่านแบบทดสอบที่<em class="font-display italic">คุณภาพ</em>
    </h1>
    <p class="mt-6 text-body text-ink-700 max-w-xl">
      MBTI / Love Language / Personality — เขียนโดยคนเข้าใจคนไทยวัยทำงานจริงๆ
      ไม่ใช่แค่แปลจากต่างประเทศ
    </p>
    {featuredQuiz && (
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href={`/quiz/${featuredQuiz.slug}/`} class="btn-primary">
          เริ่มทำ {featuredQuiz.title} →
        </a>
        <span class="text-small text-ink-500">
          ใช้เวลา {featuredQuiz.estimatedMinutes} นาที · {featuredQuiz.questions.length} คำถาม
        </span>
      </div>
    )}
  </section>

  <!-- CATEGORIES -->
  <section class="container-wide py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { href: '/mbti/', label: 'MBTI', sub: '16 บุคลิกภาพ', emoji: null, color: 'bg-analyst/10' },
        { href: '/category/love/', label: 'ความรัก', sub: 'Love Language', emoji: null, color: 'bg-coral-50' },
        { href: '/category/career/', label: 'อาชีพ', sub: 'งานที่ใช่', emoji: null, color: 'bg-sentinel/15' },
        { href: '/fun/', label: 'สนุกๆ', sub: 'Quiz เบาๆ', emoji: null, color: 'bg-explorer/15' },
      ].map((cat) => (
        <a
          href={cat.href}
          class={`${cat.color} card hover:shadow-md transition-shadow group`}
        >
          <p class="font-display text-h3 font-semibold group-hover:text-coral-400 transition-colors">
            {cat.label}
          </p>
          <p class="eyebrow mt-2">{cat.sub}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- FEATURED QUIZZES -->
  {quizzes.length > 0 && (
    <section class="container-wide py-16">
      <div class="flex items-end justify-between mb-8">
        <h2 class="text-h2 font-semibold">แบบทดสอบยอดนิยม</h2>
        <a href="/quiz/" class="text-small hover:text-coral-400">ดูทั้งหมด →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {quizzes.slice(0, 6).map((quiz) => (
          <a href={`/quiz/${quiz.slug}/`} class="card hover:shadow-md transition-shadow">
            <p class="eyebrow mb-2">{quiz.category}</p>
            <h3 class="font-display text-h3 font-semibold mb-2">{quiz.title}</h3>
            <p class="text-small text-ink-700 mb-4">{quiz.description}</p>
            <p class="text-caption text-ink-500">
              {quiz.estimatedMinutes} นาที · {quiz.questions?.length || 0} คำถาม
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- EMPTY STATE: no quizzes yet -->
  {quizzes.length === 0 && (
    <section class="container-wide py-16">
      <div class="card text-center py-16">
        <p class="eyebrow mb-3">COMING SOON</p>
        <h2 class="text-h2 font-semibold mb-3">แบบทดสอบกำลังจะมา</h2>
        <p class="text-ink-700 max-w-md mx-auto">
          เรากำลังเตรียมเนื้อหาคุณภาพ ติดตามได้เร็วๆ นี้
        </p>
      </div>
    </section>
  )}

  <!-- BLOG -->
  {recentBlog.length > 0 && (
    <section class="container-wide py-16">
      <div class="flex items-end justify-between mb-8">
        <h2 class="text-h2 font-semibold">อ่านเพิ่มเติม</h2>
        <a href="/blog/" class="text-small hover:text-coral-400">บทความทั้งหมด →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {recentBlog.map((post) => (
          <a href={`/blog/${post.slug}/`} class="group">
            <p class="eyebrow mb-2">{post.category}</p>
            <h3 class="font-display text-h3 font-semibold mb-2 group-hover:text-coral-400 transition-colors">
              {post.title}
            </h3>
            <p class="text-small text-ink-700">{post.metaDescription}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- BANNER SLOT 1: home middle (reserve fixed height for CLS=0) -->
  <section class="container-wide py-8">
    <div class="ph-img" style="height: 250px; max-width: 728px; margin: 0 auto;">
      banner-home-mid · 728×90 / 300×250
    </div>
  </section>
</BaseLayout>
