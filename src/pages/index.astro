---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getQuizzes, getMbtiTypes, getBlogPosts } from '@/lib/payload'

const quizzes = await getQuizzes()
const mbtiTypes = await getMbtiTypes()
const recentBlog = (await getBlogPosts()).slice(0, 4)
const featuredQuiz = quizzes.find((q) => q.slug === 'mbti') || quizzes[0]
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://quizdee.com'

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Quizdee',
    alternateName: ['ควิซดี', 'quizdee.com'],
    url: siteUrl + '/',
    inLanguage: 'th',
    description: 'แบบทดสอบบุคลิกภาพ MBTI / Love Language / Personality Quiz ฉบับเข้าใจคนไทยวัยทำงาน',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Quizdee',
    url: siteUrl + '/',
    logo: `${siteUrl}/logo.svg`,
    foundingDate: '2026',
    description: 'แบบทดสอบบุคลิกภาพภาษาไทย เนื้อหาสำหรับคนวัยทำงาน',
    knowsLanguage: ['th', 'en'],
    sameAs: [],
  },
]
---

<BaseLayout
  title="quizdee — แบบทดสอบบุคลิกภาพ MBTI ฉบับคนไทยวัยทำงาน"
  description="ทำแบบทดสอบ MBTI / Love Language / Personality ภาษาไทย เนื้อหาเข้าใจคนวัยทำงาน ฟรี ไม่ต้องสมัคร — ผลลัพธ์ละเอียด แชร์ได้ทันที"
  schemas={schemas}
>
  <!-- ─── HERO ─────────────────────────────────────────────── -->
  <section class="container-wide pt-10 pb-10 sm:pt-16 sm:pb-16 md:pt-20 md:pb-20">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5">EST. 2026 · BANGKOK · 季節</p>
      <h1 class="font-display font-medium leading-[1.12] tracking-tight text-balance text-sumi-800" style="font-size: clamp(1.875rem, 5.2vw, 4rem);">
        เข้าใจตัวเอง<br />
        ผ่านแบบทดสอบที่
        <em class="italic font-light text-sakura-700">เขียนด้วยใจ</em>
      </h1>
      <p class="mt-5 max-w-xl text-body text-sumi-700 text-pretty">
        MBTI · Love Language · Personality — เขียนโดยคนเข้าใจคนไทยวัยทำงานจริงๆ ไม่ใช่แค่แปลจากต่างประเทศ
      </p>
      {featuredQuiz && (
        <div class="mt-7 flex flex-wrap items-center gap-3 sm:gap-5">
          <a href={`/quiz/${featuredQuiz.slug}/`} class="btn-primary">
            เริ่มทำ {featuredQuiz.title}
            <span aria-hidden="true">→</span>
          </a>
          <span class="text-small text-sumi-500">
            {featuredQuiz.estimatedMinutes} นาที · {featuredQuiz.questions?.length || 60} คำถาม · ฟรี
          </span>
        </div>
      )}
    </div>
  </section>

  <!-- ─── CATEGORIES ───────────────────────────────────────── -->
  <section class="container-wide py-6 sm:py-10" aria-labelledby="cats-heading">
    <h2 id="cats-heading" class="sr-only">หมวดหมู่แบบทดสอบ</h2>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">
      {[
        { href: '/mbti/',          label: 'MBTI',     sub: '16 บุคลิกภาพ',   bg: 'bg-analyst'  },
        { href: '/category/love/', label: 'ความรัก',  sub: 'Love Language',  bg: 'bg-sakura-50' },
        { href: '/category/career/', label: 'อาชีพ',  sub: 'งานที่ใช่',       bg: 'bg-sentinel' },
        { href: '/fun/',           label: 'สนุกๆ',    sub: 'Quiz เบาๆ',       bg: 'bg-explorer' },
      ].map((cat) => (
        <a
          href={cat.href}
          class={`${cat.bg} card hover:shadow-card hover:-translate-y-px transition-all duration-300 ease-soft group`}
        >
          <p class="font-display text-h3 font-semibold text-sumi-900 group-hover:text-sakura-700 transition-colors">
            {cat.label}
          </p>
          <p class="eyebrow mt-2">{cat.sub}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ─── FEATURED QUIZZES ─────────────────────────────────── -->
  {quizzes.length > 0 && (
    <section class="container-wide py-16 sm:py-20" aria-labelledby="featured-heading">
      <div class="mb-8 flex items-end justify-between gap-4">
        <h2 id="featured-heading" class="font-display font-semibold">แบบทดสอบยอดนิยม</h2>
        <a href="/quiz/" class="text-small text-sumi-500 hover:text-sakura-700 transition-colors whitespace-nowrap">ดูทั้งหมด →</a>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:gap-6 md:grid-cols-2 lg:grid-cols-3">
        {quizzes.slice(0, 6).map((quiz) => (
          <a href={`/quiz/${quiz.slug}/`} class="card hover:shadow-card hover:-translate-y-px transition-all duration-300 ease-soft group">
            <p class="eyebrow mb-2">{quiz.category}</p>
            <h3 class="font-display text-h3 font-semibold mb-2 group-hover:text-sakura-700 transition-colors">{quiz.title}</h3>
            <p class="text-small text-sumi-700 line-clamp-2">{quiz.description}</p>
            <p class="mt-4 text-caption text-sumi-500">
              {quiz.estimatedMinutes} นาที · {quiz.questions?.length || 0} คำถาม
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Empty state -->
  {quizzes.length === 0 && (
    <section class="container-wide py-16 sm:py-20">
      <div class="card-flat text-center py-16 max-w-2xl mx-auto">
        <p class="eyebrow mb-3">準備中 · COMING SOON</p>
        <h2 class="text-h2 font-semibold mb-3">แบบทดสอบกำลังเตรียม</h2>
        <p class="text-sumi-700 max-w-md mx-auto">
          เรากำลังเขียนเนื้อหาคุณภาพ ติดตามได้เร็วๆ นี้
        </p>
      </div>
    </section>
  )}

  <!-- ─── BLOG ─────────────────────────────────────────────── -->
  {recentBlog.length > 0 && (
    <section class="container-wide py-16 sm:py-20" aria-labelledby="blog-heading">
      <div class="mb-8 flex items-end justify-between gap-4">
        <h2 id="blog-heading" class="font-display font-semibold">อ่านเพิ่มเติม</h2>
        <a href="/blog/" class="text-small text-sumi-500 hover:text-sakura-700 transition-colors whitespace-nowrap">บทความทั้งหมด →</a>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {recentBlog.map((post) => (
          <a href={`/blog/${post.slug}/`} class="group">
            <p class="eyebrow mb-2">{post.category}</p>
            <h3 class="font-display text-h2 sm:text-h3 font-semibold mb-2 text-balance group-hover:text-sakura-700 transition-colors">
              {post.title}
            </h3>
            <p class="text-small text-sumi-700 text-pretty">{post.metaDescription}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ─── BANNER SLOT (CLS=0 reserved) ─── -->
  <section class="container-wide py-8 sm:py-12">
    <div class="ph-img mx-auto" style="height: 250px; max-width: 728px;" aria-label="Advertisement placeholder">
      banner-home-mid · 728×90 / 300×250
    </div>
  </section>
</BaseLayout>
