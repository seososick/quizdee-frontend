---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="ติดต่อเรา — quizdee" description="ติดต่อทีม Quizdee — feedback, ความร่วมมือ, ลงโฆษณา">
  <article class="container-prose py-16">
    <p class="eyebrow mb-4">CONTACT</p>
    <h1 class="text-h1 font-semibold mb-6">ติดต่อเรา</h1>
    <p class="text-body text-ink-700 mb-6">
      มีคำถาม คำแนะนำ หรือสนใจลงโฆษณาบน Quizdee — ทักมาได้เลย
    </p>
    <div class="card">
      <p class="eyebrow mb-2">EMAIL</p>
      <p class="font-mono text-body mb-4">hello@quizdee.com</p>
      <p class="eyebrow mb-2">FORM</p>
      <p class="text-small text-ink-500 italic">[ฟอร์มติดต่อจะเพิ่มภายหลัง]</p>
    </div>
  </article>
</BaseLayout>
