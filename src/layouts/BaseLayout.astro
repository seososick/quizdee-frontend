---
import '@/styles/global.css'

interface Props {
  title: string
  description: string
  ogImage?: string
  ogType?: 'website' | 'article'
  noindex?: boolean
  canonical?: string
  schemas?: object[]
  publishedTime?: string
  modifiedTime?: string
  author?: string
  tags?: string[]
  hreflang?: Array<{ lang: string; href: string }>
}

const {
  title,
  description,
  ogImage = '/og-default.png',
  ogType = 'website',
  noindex = false,
  canonical,
  schemas = [],
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  hreflang = [],
} = Astro.props

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://quizdee.com'
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString()
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString()

// Always include base WebSite + Organization schema
const baseSchemas = schemas.length === 0
  ? [{
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Quizdee',
      url: siteUrl + '/',
      inLanguage: 'th',
    }]
  : schemas
---

<!doctype html>
<html lang="th" prefix="og: https://ogp.me/ns#">
  <head>
    <!-- Critical meta — order matters for parser perf -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FBF9F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F1A14" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light" />

    <!-- DNS prefetch + preconnect for Google Fonts (critical) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Self-host critical font subset via Google Fonts (with preload) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Title + description -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Robots -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang (default x-default = Thai) -->
    <link rel="alternate" hreflang="th" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    {hreflang.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:site_name" content="Quizdee" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@quizdee_th" />

    <!-- Favicon set -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- JSON-LD schemas -->
    {baseSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- llms.txt hint -->
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Quizdee RSS" href="/rss.xml" />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- Skip link for accessibility -->
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-washi-50 focus:px-3 focus:py-2 focus:rounded-btn focus:shadow-card">
      ข้ามไปเนื้อหาหลัก
    </a>

    <slot name="header">
      <header class="sticky top-0 z-40 border-b border-washi-300 bg-washi-50/85 backdrop-blur-md">
        <div class="container-wide flex items-center justify-between gap-4 py-3 sm:py-4">
          <a href="/" class="font-display text-xl sm:text-2xl font-semibold tracking-tight text-sumi-900 inline-flex items-center min-h-[44px] -my-2 px-1">
            quizdee<span class="text-sakura-500">.</span>
          </a>
          <nav class="flex items-center gap-4 sm:gap-7" aria-label="Main">
            <a href="/quiz/" class="nav-link">แบบทดสอบ</a>
            <a href="/mbti/" class="nav-link hidden sm:inline">MBTI</a>
            <a href="/blog/" class="nav-link hidden sm:inline">บทความ</a>
            <a href="/about/" class="nav-link hidden sm:inline">เกี่ยวกับ</a>
          </nav>
        </div>
      </header>
    </slot>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-washi-300 bg-washi-100">
      <div class="container-wide grid grid-cols-2 gap-8 py-12 text-small md:grid-cols-4">
        <div class="col-span-2 md:col-span-1">
          <p class="font-display text-h3 font-semibold text-sumi-900">
            quizdee<span class="text-sakura-500">.</span>
          </p>
          <p class="mt-2 text-sumi-500 max-w-xs">
            เข้าใจตัวเอง ผ่านแบบทดสอบบุคลิกภาพคุณภาพ ฉบับคนไทย
          </p>
        </div>
        <div>
          <p class="eyebrow mb-3">แบบทดสอบ</p>
          <ul class="text-sumi-700">
            <li><a href="/mbti/" class="footer-link">MBTI 16 แบบ</a></li>
            <li><a href="/category/love/" class="footer-link">ความรัก</a></li>
            <li><a href="/category/career/" class="footer-link">อาชีพ</a></li>
            <li><a href="/fun/" class="footer-link">สนุกๆ</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-3">เกี่ยวกับ</p>
          <ul class="text-sumi-700">
            <li><a href="/about/" class="footer-link">เรื่องของเรา</a></li>
            <li><a href="/contact/" class="footer-link">ติดต่อ</a></li>
            <li><a href="/privacy/" class="footer-link">ความเป็นส่วนตัว</a></li>
            <li><a href="/terms/" class="footer-link">เงื่อนไข</a></li>
          </ul>
        </div>
        <div class="col-span-2 md:col-span-1">
          <p class="eyebrow mb-3">เชื่อมต่อ</p>
          <p class="text-sumi-500">© 2026 quizdee.com</p>
          <p class="mt-2 text-caption text-sumi-400">
            ทำด้วยใจ ที่กรุงเทพ
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
